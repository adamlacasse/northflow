# Flask / App
FLASK_ENV=production
PORT=5000
SECRET_KEY=changeme-to-random-hex

# Database (used by both app and MySQL container)
DB_HOST=db
DB_PORT=3306
DB_USER=northflow
DB_PASSWORD=changeme-db-password
MYSQL_ROOT_PASSWORD=changeme-root-password

# Public hostname(s) asserted by the Cloudflare Worker via X-Northflow-Host.
# Required on Railway when fronted by worker.js; leave empty for local dev.
PUBLIC_HOSTS=

# OAuth (update with real values)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
