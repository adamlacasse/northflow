{
  "plugins": {
    "md013": {
      "line_length": 160,
      "code_blocks": false,
      "code_block_line_length": 160
    },
    "md024": {
      "enabled": false
    },
    "md026": {
      "punctuation": ".,;:!?"
    },
    "md036": {
      "enabled": false
    }
  },
  "extensions": {
    "front-matter": {
      "enabled": true
    }
  }
}
