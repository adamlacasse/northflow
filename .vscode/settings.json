{
  "cSpell.words": [
    "Authlib",
    "certbot",
    "clickjacking",
    "djlint",
    "gunicorn",
    "HTTPONLY",
    "mypy",
    "mysqldump",
    "Namaste",
    "nosniff",
    "procs",
    "pymarkdown",
    "pymarkdownlnt",
    "sqlfluff",
    "userinfo"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/venv": true,
    "**/*.egg-info": true
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.indexing": false,
  "python.analysis.completeFunctionParens": false
}